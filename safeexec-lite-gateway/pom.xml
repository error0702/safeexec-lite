<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>fun.autorun</groupId><artifactId>safeexec-lite</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>safeexec-lite-gateway</artifactId>
  <name>SafeExec Lite Gateway</name>
  <description>A minimal, framework-free ToolGateway: strict argument conversion, audit at every stage, in-memory Intent/Attempt idempotency and three-state recovery after a timeout. No policy, no approval, no shadow mode, nothing survives a crash — that is Pro.</description>
  <dependencies>
    <dependency><groupId>fun.autorun</groupId><artifactId>safeexec-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration><mainClass>fun.autorun.safeexec.lite.Demo</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
