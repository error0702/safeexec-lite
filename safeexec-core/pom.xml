<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fun.autorun</groupId>
    <artifactId>safeexec-lite</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>safeexec-core</artifactId>
  <name>SafeExec Core</name>
  <description>Framework-free domain model: ToolCall, PolicyFacts, Intent/Attempt, Approval, Evidence, RecoveryResult</description>

  <!-- Deliberately NO Spring, NO Spring AI, NO JPA here. Enforced below. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>core-has-no-framework-deps</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>org.springframework.ai:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                  </excludes>
                  <includes>
                    <exclude>*:*:*:*:test</exclude>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
